CREATE TRIGGER flag_suspicious_ip
AFTER INSERT ON login_attempts
FOR EACH ROW
BEGIN
    IF (SELECT COUNT(*) FROM login_attempts 
        WHERE ip_address = NEW.ip_address 
        AND success = 0 
        AND timestamp > NOW() - INTERVAL 1 HOUR) > 3 THEN
        INSERT INTO flagged_ips (ip_address, flagged_at)
        VALUES (NEW.ip_address, NOW());
    END IF;
END;
